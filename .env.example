PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Create an OAuth App at GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Use public_repo for public repositories only, or repo for public + private repositories.
GITHUB_SCOPE=public_repo

# Your active n8n production webhook URL
N8N_WEBHOOK_URL=https://zaimamashiat.app.n8n.cloud/webhook/f4f526f6-4f6c-4988-82b0-cdc0d8c4f52a

# Optional shared secret. Set the same value as Header Auth in the n8n Webhook node.
N8N_WEBHOOK_SECRET=

# Used as the target folder default on the website.
DEFAULT_GITHUB_FOLDER=public/blog
NODE_ENV=development
